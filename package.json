{
  "name": "vitest-dynoxide",
  "version": "0.0.0",
  "description": "Vitest integration for testing against Dynoxide instances",
  "homepage": "https://github.com/seek-oss/vitest-dynoxide#readme",
  "bugs": {
    "url": "https://github.com/seek-oss/vitest-dynoxide/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/seek-oss/vitest-dynoxide.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#src/*": {
      "@seek/vitest-dynoxide/source": "./src/*",
      "default": "./lib/*"
    }
  },
  "exports": {
    ".": {
      "@seek/vitest-dynoxide/source": "./src/index.ts",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./lib/index.d.mts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "skuba build-package",
    "format": "skuba format",
    "lint": "skuba lint",
    "release": "changeset publish",
    "test": "skuba test",
    "test:ci": "skuba test --coverage",
    "test:watch": "skuba test --watch",
    "version": "changeset version"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "skuba": "16.3.0-main-20260804032943"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "exports": {
      ".": "./lib/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "skuba": {
    "entryPoint": "src/index.ts",
    "template": "oss-npm-package",
    "type": "package",
    "version": "16.4.0-import-ts-20260727110649"
  }
}
